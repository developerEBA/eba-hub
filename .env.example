NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Server-only Google organizer integration. Never use NEXT_PUBLIC_ prefixes.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_WEB_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_ORGANIZER_EMAIL=organizer@example.com
# Optional server-only explicit EBA import coordinator. Requires successful OAuth
# proof for this SAME existing verified active Admin; never matched by domain.
# Leave blank to require a real eligible EBA account with the Google email.
GOOGLE_IMPORT_OWNER_EMAIL=
# Optional call-ending permission. Existing authorization stays valid when false.
# true requests meetings.space.created on a deliberate Admin reconnect; Google
# may still deny ending Calendar-created spaces. Never implies capability success.
GOOGLE_MEET_CALL_ENDING_ENABLED=false
# Canonical base64 encoding of 32 cryptographically random bytes. Keep outside DB.
GOOGLE_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_ENCRYPTION_KEY
# Separate server-only bearer secret (at least 32 random characters) for the sync worker.
CALENDAR_SYNC_SECRET=YOUR_RANDOM_SERVER_ONLY_WORKER_SECRET
