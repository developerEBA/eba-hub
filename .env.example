NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Explicitly permits fictional sample UI in production with no Supabase config.
EBA_SETUP_PREVIEW=false

# Canonical application origin for OAuth; never infer it from untrusted Host headers.
APP_URL=http://localhost:3000


# Optional operator declaration only; set true after enabling and observing pg_cron.
# This changes setup copy, not scheduler execution or a health check.
REMINDER_SCHEDULER_ENABLED=false

